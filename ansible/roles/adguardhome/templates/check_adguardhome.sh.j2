#!/bin/bash
# AdGuard Home Health Check Script for Keepalived
# This script checks if AdGuard Home is healthy and able to serve DNS queries

set -e

# Configuration
CONTAINER_NAME="adguardhome"
DNS_PORT={{ adguardhome_dns_port }}
HTTP_PORT={{ adguardhome_http_port }}
TEST_DOMAIN="google.com"
TIMEOUT=3

# Function to log messages
log() {
    logger -t "keepalived-check" "$1"
}

# Check 1: Container is running
if ! docker ps --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$"; then
    log "FAIL: AdGuard Home container is not running"
    exit 1
fi

# Check 2: Container is healthy (not restarting)
CONTAINER_STATUS=$(docker inspect --format='{{.State.Status}}' ${CONTAINER_NAME} 2>/dev/null || echo "unknown")
if [ "$CONTAINER_STATUS" != "running" ]; then
    log "FAIL: AdGuard Home container status is ${CONTAINER_STATUS}"
    exit 1
fi

# Check 3: DNS query test
if command -v dig &> /dev/null; then
    if ! dig @127.0.0.1 -p ${DNS_PORT} ${TEST_DOMAIN} +short +timeout=${TIMEOUT} +tries=1 > /dev/null 2>&1; then
        log "FAIL: DNS query to AdGuard Home failed"
        exit 1
    fi
elif command -v nslookup &> /dev/null; then
    if ! timeout ${TIMEOUT} nslookup ${TEST_DOMAIN} 127.0.0.1 > /dev/null 2>&1; then
        log "FAIL: DNS query to AdGuard Home failed"
        exit 1
    fi
else
    log "WARN: No DNS query tool available (dig or nslookup)"
fi

# Check 4: HTTP API health check
if command -v curl &> /dev/null; then
    if ! curl -sf --connect-timeout ${TIMEOUT} http://127.0.0.1:${HTTP_PORT}/control/status > /dev/null 2>&1; then
        log "FAIL: AdGuard Home HTTP API health check failed"
        exit 1
    fi
else
    log "WARN: curl not available for HTTP health check"
fi

# All checks passed
exit 0
